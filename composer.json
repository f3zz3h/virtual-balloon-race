{
	"name": "f3zz3h/virtual-balloon-race",
	"description": "Development tools for the Virtual Balloon Race WordPress plugin. The plugin itself has no Composer dependencies.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/woocommerce-stubs": "^10.0",
		"php-stubs/wp-cli-stubs": "^2.11"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		},
		"platform": {
			"php": "8.3"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse --memory-limit=1G"
	}
}
